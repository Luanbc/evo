# Copie para .env e preencha. Nunca coloque o .env no repositório.

# Chave da API (todas as chamadas levam o cabeçalho "apikey: <esta chave>").
# Gere uma com:  openssl rand -hex 32
AUTHENTICATION_API_KEY=COLE_AQUI_UMA_CHAVE_LONGA

# Senha do Postgres da Evolution.  Gere com:  openssl rand -hex 24
POSTGRES_PASSWORD=COLE_AQUI_UMA_SENHA_LONGA

# Endereço público da API (o do proxy com HTTPS). Só aparece nas respostas e nos webhooks.
SERVER_URL=https://wpp.seu-dominio.com.br

# Porta local da API (fica presa a 127.0.0.1)
EVOLUTION_PORTA=8080

# Nome que aparece em "Aparelhos conectados" no celular
NOME_APARELHO=Meu Projeto
